# Copy these settings into the repository-root .env file used by the API.
# Generate JWT_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=expertise-automation-api
JWT_AUDIENCE=expertise-automation-web

# Comma-separated browser origins; use the exact scheme, host, and port.
FRONTEND_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SAME_SITE=lax

# Needed only when running the Prisma seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
