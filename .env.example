# Copy these settings into the repository-root .env file used by the API.
# Generate JWT_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATABASE_URL=postgresql://postgres:password@localhost:5432/expertise_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=expertise_automation
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PORT=3000
JWT_SECRET=
JWT_ISSUER=expertise-automation-api
JWT_AUDIENCE=expertise-automation-web

# Comma-separated browser origins; use the exact scheme, host, and port.
FRONTEND_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SAME_SITE=lax
DOCUMENT_STORAGE_DIR=
OCR_CACHE_DIR=

# Gemini API key used by backend-only AI features.
GEMINI_API_KEY=
# Rate-limit fallback order: Gemini 3.8 Flash, 3.7 Flash, 3.6 Flash, 3.5 Flash-Lite, then 3.5 Flash.

# Needed only when running the Prisma seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
