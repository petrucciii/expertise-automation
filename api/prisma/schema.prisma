// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  AI
  ASSISTANT
}

enum CaseFamily {
  CARGO_DAMAGE
  CARGO_CONTAMINATION
  SHORTAGE
  TEMPERATURE_EXCURSION
  OTHER
}

enum CaseStatus {
  INTAKE
  IN_REVIEW
  DRAFT
  APPROVED
}

enum EvidenceStatus {
  OBSERVED
  REPORTED
  STATED_IN_DOCUMENT
  CALCULATED
  DISPUTED
  UNKNOWN
}

enum DocumentAvailability {
  ORIGINAL_ACCESSIBLE
  EXCERPT_ONLY
  REFERENCED_NOT_ACCESSIBLE
  NOT_PROVIDED
}

enum ExtractionStatus {
  PENDING
  EXTRACTED
  NEEDS_REVIEW
}

enum EventDateType {
  EVENT
  DOCUMENT
  RECEIVED
  UNKNOWN
}

enum ChecklistStatus {
  COMPLIANT
  ISSUE_FOUND
  NOT_VERIFIABLE
  NOT_APPLICABLE
}

enum CaseArtifactType {
  STRUCTURED_CASE
  DOCUMENT_REGISTER
  PRELIMINARY_REVIEW
  SURVEY_REPORT_DRAFT
}

enum ArtifactStatus {
  DRAFT
  APPROVED
}

enum ExtractionProposalStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum ExtractionSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ExtractionSuggestionKind {
  FACT
  EVENT
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  chats         Chat[]
  documents     Document[]
  cases         Case[]
  caseArtifacts CaseArtifact[]
  createdExtractionProposals CaseExtractionProposal[]
  reviewedExtractionSuggestions CaseExtractionSuggestion[] @relation("ReviewedSuggestions")
  refreshTokens RefreshToken[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
}

model RefreshToken {
  // The authentication package uses SHA-256(token) as this primary key.
  id              String    @id
  familyId        String    @map("family_id")
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  familyExpiresAt DateTime  @map("family_expires_at")
  usedAt          DateTime? @map("used_at")
  revoked         Boolean   @default(false)
  claims          Json?

  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([familyExpiresAt], map: "refresh_tokens_family_expires_at_idx")
  @@map("refresh_tokens")
}

model Chat {
  id         String         @id @default(uuid(7)) @db.Uuid
  title      String?
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  caseId     String?        @db.Uuid
  case       Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages   Message[]
  documents  ChatDocument[]
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  deleted_at DateTime?

  @@index([userId, updated_at])
  @@index([caseId])
}

model Message {
  id         String          @id @default(uuid(7)) @db.Uuid
  chatId     String          @db.Uuid
  chat       Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String          @db.Text
  sources    MessageSource[]
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  deleted_at DateTime?

  @@index([chatId, created_at])
}

model Document {
  id             String          @id @default(uuid(7)) @db.Uuid
  ownerId        Int
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  fileName       String
  mimeType       String
  path           String
  hash           String
  extractedText  String?         @db.Text @map("extracted_text")
  extractedPages Json?           @db.JsonB @map("extracted_pages")
  extractionStatus ExtractionStatus @default(PENDING) @map("extraction_status")
  sourceMetadata Json?           @db.JsonB @map("source_metadata")
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  chatLinks      ChatDocument[]
  messageSources MessageSource[]
  caseLinks      CaseDocument[]
}

model ChatDocument {
  chatId     String   @db.Uuid
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attachedAt DateTime @default(now())

  @@id([chatId, documentId])
  @@index([documentId])
}

model MessageSource {
  id         String   @id @default(cuid())
  messageId  String   @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int?
  excerpt    String?  @db.Text

  @@index([messageId])
  @@index([documentId])
}

model Case {
  id                   String          @id @default(uuid(7)) @db.Uuid
  ownerId              Int             @map("owner_id")
  owner                User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title                String          @db.VarChar(200)
  internalReference    String?         @map("internal_reference") @db.VarChar(120)
  publicReference      String?         @map("public_reference") @db.VarChar(160)
  caseFamily           CaseFamily      @default(CARGO_DAMAGE) @map("case_family")
  status               CaseStatus      @default(INTAKE)
  assignment           Json?           @db.JsonB
  shipment             Json?           @db.JsonB
  parties              Json?           @db.JsonB
  damageAssessment     Json?           @map("damage_assessment") @db.JsonB
  openQuestions        String[]        @default([]) @map("open_questions")
  reportTemplateId     String          @default("cargo_damage_general_it_v1") @map("report_template_id")
  clicheSetVersion     String?         @map("cliche_set_version")
  nextDocumentNumber   Int             @default(1) @map("next_document_number")
  revision             Int             @default(1)
  documents            CaseDocument[]
  events               CaseEvent[]
  evidence             CaseEvidence[]
  issues               CaseIssue[]
  chats                Chat[]
  artifacts            CaseArtifact[]
  extractionProposals  CaseExtractionProposal[]
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  @@index([ownerId, status, updatedAt])
  @@map("cases")
}

model CaseDocument {
  id              String              @id @default(uuid(7)) @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  case            Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId      String?             @map("document_id") @db.Uuid
  document        Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceCode      String              @map("source_code") @db.VarChar(40)
  displayName     String?             @map("display_name") @db.VarChar(240)
  documentType    String?             @map("document_type") @db.VarChar(80)
  verificationPurpose String?         @map("verification_purpose") @db.Text
  documentDate    DateTime?           @map("document_date")
  senderOrAuthor  String?             @map("sender_or_author") @db.VarChar(240)
  availability    DocumentAvailability @default(ORIGINAL_ACCESSIBLE)
  metadata        Json?               @db.JsonB
  attachedAt      DateTime            @default(now()) @map("attached_at")
  events          CaseEvent[]
  evidence        CaseEvidence[]
  eventSources    CaseEventSource[]
  evidenceSources CaseEvidenceSource[]
  extractionProposals CaseExtractionProposal[]

  @@unique([caseId, documentId])
  @@unique([caseId, sourceCode])
  @@index([documentId])
  @@map("case_documents")
}

model CaseEvent {
  id                String          @id @default(uuid(7)) @db.Uuid
  caseId            String          @map("case_id") @db.Uuid
  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  event             String          @db.Text
  date              DateTime?
  dateType          EventDateType   @default(UNKNOWN) @map("date_type")
  epistemicStatus   EvidenceStatus  @map("epistemic_status")
  caseDocumentId    String?         @map("case_document_id") @db.Uuid
  source            CaseDocument?   @relation(fields: [caseDocumentId], references: [id], onDelete: Restrict)
  pageNumber        Int?            @map("page_number")
  excerpt           String?         @db.Text
  sourceLinks       CaseEventSource[]
  extractionSuggestion CaseExtractionSuggestion? @relation("EventSuggestion")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([caseId, date])
  @@index([caseDocumentId])
  @@map("case_events")
}

model CaseEvidence {
  id                String          @id @default(uuid(7)) @db.Uuid
  caseId            String          @map("case_id") @db.Uuid
  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldKey          String          @map("field_key") @db.VarChar(160)
  value             Json            @db.JsonB
  unit              String?         @db.VarChar(40)
  comparisonGroup   String?         @map("comparison_group") @db.VarChar(160)
  epistemicStatus   EvidenceStatus  @map("epistemic_status")
  attribution       String?         @db.VarChar(240)
  caseDocumentId    String?         @map("case_document_id") @db.Uuid
  source            CaseDocument?   @relation(fields: [caseDocumentId], references: [id], onDelete: Restrict)
  pageNumber        Int?            @map("page_number")
  excerpt           String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  sourceLinks       CaseEvidenceSource[]
  issueLinks        CaseIssueEvidence[]
  extractionSuggestion CaseExtractionSuggestion? @relation("EvidenceSuggestion")

  @@index([caseId, fieldKey, comparisonGroup])
  @@index([caseDocumentId])
  @@map("case_evidence")
}

model CaseIssue {
  id              String              @id @default(uuid(7)) @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  case            Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ruleId          String?             @map("rule_id") @db.VarChar(120)
  ruleVersion     String?             @map("rule_version") @db.VarChar(80)
  status          ChecklistStatus
  severity        String?             @db.VarChar(40)
  title           String              @db.VarChar(240)
  explanation     String              @db.Text
  suggestedCheck String?             @map("suggested_check") @db.Text
  evidence        CaseIssueEvidence[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([caseId, status])
  @@map("case_issues")
}

model CaseIssueEvidence {
  issueId    String      @map("issue_id") @db.Uuid
  issue      CaseIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  evidenceId String      @map("evidence_id") @db.Uuid
  evidence   CaseEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([issueId, evidenceId])
  @@index([evidenceId])
  @@map("case_issue_evidence")
}

model CaseEventSource {
  eventId         String       @map("event_id") @db.Uuid
  event           CaseEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  caseDocumentId  String       @map("case_document_id") @db.Uuid
  caseDocument    CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Restrict)
  pageNumber      Int?         @map("page_number")
  excerpt         String?      @db.Text

  @@id([eventId, caseDocumentId])
  @@index([caseDocumentId])
  @@map("case_event_sources")
}

model CaseEvidenceSource {
  evidenceId      String       @map("evidence_id") @db.Uuid
  evidence        CaseEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  caseDocumentId  String       @map("case_document_id") @db.Uuid
  caseDocument    CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Restrict)
  pageNumber      Int?         @map("page_number")
  excerpt         String?      @db.Text

  @@id([evidenceId, caseDocumentId])
  @@index([caseDocumentId])
  @@map("case_evidence_sources")
}

model CaseArtifact {
  id             String           @id @default(uuid(7)) @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdById    Int              @map("created_by_id")
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  type           CaseArtifactType
  version        Int
  caseRevision   Int              @map("case_revision")
  status         ArtifactStatus   @default(DRAFT)
  content        Json             @db.JsonB
  model          String?          @db.VarChar(120)
  promptVersion  String?          @map("prompt_version") @db.VarChar(80)
  createdAt      DateTime         @default(now()) @map("created_at")
  approvedAt     DateTime?        @map("approved_at")

  @@unique([caseId, type, version])
  @@map("case_artifacts")
}

model CaseExtractionProposal {
  id              String                    @id @default(uuid(7)) @db.Uuid
  caseId          String                    @map("case_id") @db.Uuid
  case            Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseDocumentId  String                    @map("case_document_id") @db.Uuid
  caseDocument    CaseDocument              @relation(fields: [caseDocumentId], references: [id], onDelete: Restrict)
  createdById     Int                       @map("created_by_id")
  createdBy       User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  documentType    String                    @map("document_type") @db.VarChar(80)
  model           String                    @db.VarChar(120)
  promptVersion   String                    @map("prompt_version") @db.VarChar(80)
  status          ExtractionProposalStatus  @default(PENDING)
  openQuestions   String[]                  @default([]) @map("open_questions")
  suggestions     CaseExtractionSuggestion[]
  createdAt       DateTime                  @default(now()) @map("created_at")
  reviewedAt      DateTime?                 @map("reviewed_at")

  @@index([caseId, createdAt])
  @@index([caseDocumentId])
  @@map("case_extraction_proposals")
}

model CaseExtractionSuggestion {
  id             String                     @id @default(uuid(7)) @db.Uuid
  proposalId     String                     @map("proposal_id") @db.Uuid
  proposal       CaseExtractionProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  kind           ExtractionSuggestionKind
  content        Json                       @db.JsonB
  status         ExtractionSuggestionStatus @default(PENDING)
  caseEvidenceId String?                    @unique @map("case_evidence_id") @db.Uuid
  caseEvidence   CaseEvidence?              @relation("EvidenceSuggestion", fields: [caseEvidenceId], references: [id], onDelete: SetNull)
  caseEventId    String?                    @unique @map("case_event_id") @db.Uuid
  caseEvent      CaseEvent?                 @relation("EventSuggestion", fields: [caseEventId], references: [id], onDelete: SetNull)
  reviewedById   Int?                       @map("reviewed_by_id")
  reviewedBy     User?                      @relation("ReviewedSuggestions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?                  @map("reviewed_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([proposalId, status])
  @@map("case_extraction_suggestions")
}
