// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  AI
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  chats         Chat[]
  documents     Document[]
  refreshTokens RefreshToken[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
}

model RefreshToken {
  // The authentication package uses SHA-256(token) as this primary key.
  id              String    @id
  familyId        String    @map("family_id")
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  familyExpiresAt DateTime  @map("family_expires_at")
  usedAt          DateTime? @map("used_at")
  revoked         Boolean   @default(false)
  claims          Json?

  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([familyExpiresAt], map: "refresh_tokens_family_expires_at_idx")
  @@map("refresh_tokens")
}

model Chat {
  id         String         @id @default(uuid(7)) @db.Uuid
  title      String?
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages   Message[]
  documents  ChatDocument[]
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  deleted_at DateTime?

  @@index([userId])
}

model Message {
  id         String          @id @default(uuid(7)) @db.Uuid
  chatId     String          @db.Uuid
  chat       Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String          @db.Text
  sources    MessageSource[]
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  deleted_at DateTime?

  @@index([chatId, created_at])
}

model Document {
  id             String          @id @default(uuid(7)) @db.Uuid
  ownerId        Int
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  fileName       String
  mimeType       String
  path           String
  hash           String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  chatLinks      ChatDocument[]
  messageSources MessageSource[]
}

model ChatDocument {
  chatId     String   @db.Uuid
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attachedAt DateTime @default(now())

  @@id([chatId, documentId])
  @@index([documentId])
}

model MessageSource {
  id         String   @id @default(cuid())
  messageId  String   @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int?
  excerpt    String?  @db.Text

  @@index([messageId])
  @@index([documentId])
}
